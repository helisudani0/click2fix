# Secret-capable variables can be literal values or secret refs:
# - env://OTHER_ENV_VAR
# - file://./secrets/name.txt
# - vault://secret/data/click2fix/backend#field

# Core backend settings
DATABASE_URL=postgresql+psycopg2://click2fix:click2fix@db:5432/click2fix
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_32_PLUS_CHARS
JWT_ALGO=HS256
TOKEN_EXP_HOURS=8
C2F_ORCHESTRATION_MODE=endpoint

# Wazuh manager API credentials
WAZUH_URL=https://WAZUH_MANAGER_IP:55000
WAZUH_USER=c2f_api
WAZUH_PASSWORD=REPLACE_WITH_WAZUH_PASSWORD

# Wazuh indexer credentials
INDEXER_URL=https://WAZUH_INDEXER_IP:9200
INDEXER_USER=admin
INDEXER_PASSWORD=REPLACE_WITH_INDEXER_PASSWORD
OTX_API_KEY=

# Optional runtime settings
REDIS_URL=redis://localhost:6379/0
C2F_FORENSICS_PATH=./data/forensics
C2F_AI_FEATURES_ENABLED=false
# Legacy alias retained for compatibility; keep same value as C2F_AI_FEATURES_ENABLED.
C2F_AI_REMEDIATION_ENABLED=false
C2F_LLM_PROVIDER=openai
# Leave blank to use provider defaults. Gemini uses the native JSON-mode endpoint automatically.
C2F_LLM_BASE_URL=
C2F_LLM_MODEL=
C2F_LLM_API_KEY=
# Optional OpenAI aliases (supported when provider=openai and C2F_LLM_API_KEY is empty)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
C2F_CUTOVER_TEST_MODE=false
C2F_ENABLE_V1_SOAR=true
C2F_ENABLE_V2_SOAR=true
C2F_ENABLE_V1_SOAR_DEPRECATION_HEADERS=true
C2F_V1_SOAR_SUNSET=Wed, 30 Sep 2026 00:00:00 GMT

# Endpoint connector credentials
C2F_WINRM_USERNAME=
C2F_WINRM_PASSWORD=
C2F_WINRM_USERNAME_001=
C2F_WINRM_PASSWORD_001=
C2F_WINRM_USERNAME_004=
C2F_WINRM_PASSWORD_004=
C2F_SSH_USERNAME=
C2F_SSH_PASSWORD=

C2F_WINDOWS_CONNECTOR_ENABLED=true
C2F_LINUX_CONNECTOR_ENABLED=false

# Native C2F agent-manager (optional, for non-Wazuh endpoint mode)
C2F_AGENT_MANAGER_URL=http://agent-manager:8091
C2F_AGENT_MANAGER_CONTROL_TOKEN=REPLACE_WITH_AGENT_MANAGER_CONTROL_TOKEN
C2F_AGENT_MANAGER_BOOTSTRAP_TOKEN=REPLACE_WITH_ENROLLMENT_BOOTSTRAP_TOKEN
C2F_AGENT_MANAGER_TIMEOUT_SECONDS=10

# Native C2F event indexer (optional, for v2 event search/raw retrieval)
C2F_EVENT_INDEXER_URL=http://event-indexer:8092
C2F_EVENT_INDEXER_TOKEN=REPLACE_WITH_EVENT_INDEXER_TOKEN
C2F_EVENT_INDEXER_TIMEOUT_SECONDS=10

# Native C2F alert-service extraction (optional)
C2F_ALERT_SERVICE_URL=http://alert-service:8093
C2F_ALERT_SERVICE_TOKEN=REPLACE_WITH_ALERT_SERVICE_TOKEN
C2F_ALERT_SERVICE_TIMEOUT_SECONDS=10

# Native C2F case-service extraction (optional)
C2F_CASE_SERVICE_URL=http://case-service:8094
C2F_CASE_SERVICE_TOKEN=REPLACE_WITH_CASE_SERVICE_TOKEN
C2F_CASE_SERVICE_TIMEOUT_SECONDS=10

# Native C2F soar-service extraction (optional)
C2F_SOAR_SERVICE_URL=http://soar-service:8095
C2F_SOAR_SERVICE_TOKEN=REPLACE_WITH_SOAR_SERVICE_TOKEN
C2F_SOAR_SERVICE_TIMEOUT_SECONDS=10

# Optional Vault integration for secret refs
# C2F_VAULT_ADDR=https://vault.example:8200
# C2F_VAULT_TOKEN=REPLACE_WITH_VAULT_TOKEN
# C2F_VAULT_NAMESPACE=
